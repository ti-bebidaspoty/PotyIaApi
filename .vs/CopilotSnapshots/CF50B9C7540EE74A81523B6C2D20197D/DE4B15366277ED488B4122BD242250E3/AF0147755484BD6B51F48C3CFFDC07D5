using Microsoft.AspNetCore.Mvc;
using PotyIaApi.Models;
using PotyIaApi.Services;

namespace PotyIaApi.Controllers
{
    [Route("api/[controller]")]
    [ApiController]
    public class AutenticacaoController : BasicaController
    {
        private readonly IConfiguration _configuracao;
        private readonly AutenticacaoService _autenticacaoService;
        private readonly RefreshTokenService _refreshTokenService;

        public AutenticacaoController(IConfiguration configuration, AutenticacaoService autenticacaoService, RefreshTokenService refreshTokenService)
        {
            _configuracao = configuration;
            _autenticacaoService = autenticacaoService;
            _refreshTokenService = refreshTokenService;
        }

        [HttpPost]
        [Route("")]
        public IActionResult RealizarAutenticacao([FromBody] AutenticacaoModel login)
        {
            try
            {
                var usuario = _autenticacaoService.RealizarAutenticacao(login);

                if (usuario == null)
                    return retornoApi(null, 400, "Usuário ou senha incorretos!");

                var tokens = _refreshTokenService.GerarTokens(usuario);

                return retornoApi(new
                {
                    AccessToken = tokens.AccessToken,
                    RefreshToken = tokens.RefreshToken,
                    RefreshTokenExpiraEm = tokens.RefreshTokenExpiraEm,
                    Usuario = usuario
                });
            }
            catch (Exception ex)
            {
                return retornoApi(null, 500, $"Erro ao autenticar usuário: {ex.Message}");
            }
        }

        [HttpPost]
        [Route("refresh-token")]
        public IActionResult RenovarToken([FromBody] RefreshTokenRequestModel requisicao)
        {
            try
            {
                if (requisicao == null || string.IsNullOrWhiteSpace(requisicao.RefreshToken))
                    return retornoApi(null, 401, "Não autorizado.");

                var resultado = _refreshTokenService.RenovarTokens(requisicao.RefreshToken);

                // Mensagem genérica para não expor se o token existe, expirou,
                // foi revogado ou pertence a outro usuário.
                if (!resultado.Sucesso || resultado.Tokens == null)
                    return retornoApi(null, 401, "Não autorizado.");

                return retornoApi(new
                {
                    AccessToken = resultado.Tokens.AccessToken,
                    RefreshToken = resultado.Tokens.RefreshToken,
                    RefreshTokenExpiraEm = resultado.Tokens.RefreshTokenExpiraEm
                });
            }
            catch (Exception)
            {
                // Não vaza detalhes internos na resposta de erro.
                return retornoApi(null, 401, "Não autorizado.");
            }
        }
    }
}
